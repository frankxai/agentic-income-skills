{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@agentic-income/core": ["../core/dist/index.d.ts"],
      "@agentic-income/catalog": ["../catalog/dist/index.d.ts"],
      "@agentic-income/redirect": ["../redirect/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
